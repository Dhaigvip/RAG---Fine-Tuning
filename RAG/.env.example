# Copy to .env and fill in your own values. .env itself is gitignored.
AWS_REGION=eu-central-1
AWS_PROFILE=ai-lab
TOOL_RAG_EMBED_MODEL=amazon.titan-embed-text-v2:0
TOOL_RAG_EMBED_DIM=1024

# Reranking (hybrid_search.py) — all optional, shown here at their defaults.
# TOOL_RAG_RERANK_BACKEND=local           # local | bedrock — bedrock is SCP-blocked on this account for now
# TOOL_RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # used when RERANK_BACKEND=local
# TOOL_RAG_BEDROCK_RERANK_MODEL=cohere.rerank-v3-5:0            # used when RERANK_BACKEND=bedrock
# TOOL_RAG_RERANK_MIN_SCORE_LOCAL=0.0     # drop local-backend candidates scoring below this; empty = no filtering
# TOOL_RAG_RERANK_MIN_SCORE_BEDROCK=      # unset by default — uncalibrated, backend hasn't been used yet
