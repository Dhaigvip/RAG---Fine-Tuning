# Copy to .env and fill in your own values. .env itself is gitignored.
AWS_REGION=eu-central-1
AWS_PROFILE=ai-lab
TOOL_RAG_EMBED_MODEL=amazon.titan-embed-text-v2:0
TOOL_RAG_EMBED_DIM=1024
# Query transformation strategy to use for RAG (none | hyde)
TOOL_RAG_QUERY_TRANSFORM="hyde"

# Reranking (hybrid_search.py) — all optional, shown here at their defaults.
# TOOL_RAG_RERANK_BACKEND=local           # local | bedrock — bedrock is SCP-blocked on this account for now
# TOOL_RAG_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2   # used when RERANK_BACKEND=local
# TOOL_RAG_BEDROCK_RERANK_MODEL=cohere.rerank-v3-5:0            # used when RERANK_BACKEND=bedrock
# TOOL_RAG_RERANK_MIN_SCORE_LOCAL=0.0     # drop local-backend candidates scoring below this; empty = no filtering
# TOOL_RAG_RERANK_MIN_SCORE_BEDROCK=      # unset by default — uncalibrated, backend hasn't been used yet

# Query transformation (query_transform.py) — all optional, shown here at their defaults.
# TOOL_RAG_QUERY_TRANSFORM=hyde                            # none | hyde — see docs/query-transformation-strategies.md
# TOOL_RAG_HYDE_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0   # Claude Haiku 4.5 via the eu. cross-region inference profile (Sept 15 standing instruction)
# TOOL_RAG_HYDE_MAX_TOKENS=200

# Generation (generate.py) — all optional, shown here at their defaults. Kept
# as its OWN model var rather than reusing TOOL_RAG_HYDE_MODEL on purpose —
# see docs/generation-strategies.md ("Model — separate config from HyDE").
# TOOL_RAG_GENERATION_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0   # same default as HyDE, independently upgradeable
# TOOL_RAG_GENERATION_MAX_TOKENS=500
